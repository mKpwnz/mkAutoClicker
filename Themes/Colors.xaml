<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.AppBackground">#18181B</Color>
    <Color x:Key="Color.AppSurface">#18181B</Color>
    <Color x:Key="Color.AppSurfaceSoft">#27272A</Color>
    <Color x:Key="Color.AppSurfaceElevated">#2F2F35</Color>
    <Color x:Key="Color.AppBorder">#404046</Color>
    <Color x:Key="Color.AppBorderStrong">#52525B</Color>
    <Color x:Key="Color.AppBorderHover">#6B6B75</Color>
    <Color x:Key="Color.TextPrimary">#FAFAFA</Color>
    <Color x:Key="Color.TextSecondary">#D4D4D8</Color>
    <Color x:Key="Color.TextMuted">#A1A1AA</Color>
    <Color x:Key="Color.Accent">#00a6f4</Color>
    <Color x:Key="Color.AccentHover">#00a6f4</Color>
    <Color x:Key="Color.AccentSoft">#00598a</Color>
    <Color x:Key="Color.AccentText">#EFF6FF</Color>
    <Color x:Key="Color.Warning">#fb2c36</Color>
    <Color x:Key="Color.WarningSoft">#9f0712</Color>
    <Color x:Key="Color.FocusRing">#A1A1AA</Color>

    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.AppSurface" Color="{StaticResource Color.AppSurface}" />
    <SolidColorBrush x:Key="Brush.AppSurfaceSoft" Color="{StaticResource Color.AppSurfaceSoft}" />
    <SolidColorBrush x:Key="Brush.AppSurfaceElevated" Color="{StaticResource Color.AppSurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.AppBorder" Color="{StaticResource Color.AppBorder}" />
    <SolidColorBrush x:Key="Brush.AppBorderStrong" Color="{StaticResource Color.AppBorderStrong}" />
    <SolidColorBrush x:Key="Brush.AppBorderHover" Color="{StaticResource Color.AppBorderHover}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />

</ResourceDictionary>