    <sys:String x:Key="Ui.Validation.DutyMin">Le duty min doit être entre 1 et 99 %.</sys:String>
    <sys:String x:Key="Ui.Validation.DutyMax">Le duty max doit être entre 1 et 99 %.</sys:String>
    <sys:String x:Key="Ui.Validation.DutyRange">Le duty min ne peut pas être supérieur au duty max.</sys:String>
    <sys:String x:Key="Ui.Validation.ClickLimit">La limite de clics doit être supérieure à 0.</sys:String>
    <sys:String x:Key="Ui.Validation.TimeLimit">La limite de temps doit être d'au moins 1 seconde.</sys:String>
    <sys:String x:Key="Ui.Validation.KeyboardKey">Veuillez sélectionner une touche clavier.</sys:String>
