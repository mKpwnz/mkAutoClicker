    <sys:String x:Key="Ui.Keyboard.Group.Other">Autres touches</sys:String>

    <sys:String x:Key="Ui.Status.Idle">Inactif</sys:String>
    <sys:String x:Key="Ui.Status.Running">En cours</sys:String>
    <sys:String x:Key="Ui.Status.Stopped">Arrêté</sys:String>
    <sys:String x:Key="Ui.Status.StoppedClickLimit">Arrêté (limite de clics atteinte)</sys:String>
    <sys:String x:Key="Ui.Status.StoppedTimeLimit">Arrêté (limite de temps atteinte)</sys:String>
