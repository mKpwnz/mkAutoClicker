<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Localization.Overlay">fr</sys:String>

    <sys:String x:Key="Ui.Window.Title">mKAutoClicker</sys:String>

    <sys:String x:Key="Ui.Header.Status.Initial">Statut: Inactif</sys:String>
    <sys:String x:Key="Ui.Header.Clicks.Initial">Clics: 0</sys:String>
    <sys:String x:Key="Ui.Header.Elapsed.Initial">Temps: 00:00:00</sys:String>
    <sys:String x:Key="Ui.Header.Status.Format">Statut: {0}</sys:String>
    <sys:String x:Key="Ui.Header.Clicks.Format">Clics: {0}</sys:String>
    <sys:String x:Key="Ui.Header.Elapsed.Format">Temps: {0}</sys:String>

    <sys:String x:Key="Ui.Tab.Action">Action</sys:String>
