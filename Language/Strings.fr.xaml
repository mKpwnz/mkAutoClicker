    <sys:String x:Key="Ui.Tab.Limits">Limites</sys:String>
    <sys:String x:Key="Ui.Tab.Hotkey">Raccourci</sys:String>
    <sys:String x:Key="Ui.Tab.Settings">Paramètres</sys:String>

    <sys:String x:Key="Ui.Action.InputType.Label">Type d'entrée</sys:String>
    <sys:String x:Key="Ui.Action.InputType.Description">Mouse Left, Mouse Middle, Mouse Right ou Keyboard Key.</sys:String>
    <sys:String x:Key="Ui.Action.KeyboardKey.Label">Touche clavier</sys:String>
    <sys:String x:Key="Ui.Action.KeyboardKey.Description">Visible uniquement si Keyboard Key est sélectionné.</sys:String>

    <sys:String x:Key="Ui.Timing.ClicksPerSecond.Label">Clics/s</sys:String>
    <sys:String x:Key="Ui.Timing.ClicksPerSecond.Description">0,1 à 1000 clics par seconde.</sys:String>
