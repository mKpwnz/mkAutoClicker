    <sys:String x:Key="Ui.Status.HotkeyRegisterFailed">Impossible d'enregistrer le raccourci. Choisissez une autre combinaison.</sys:String>
    <sys:String x:Key="Ui.Status.HotkeyCaptureCancelled">Enregistrement du raccourci annulé.</sys:String>
    <sys:String x:Key="Ui.Status.HotkeyNeedNonModifier">Veuillez appuyer sur au moins une touche non-modificateur.</sys:String>
    <sys:String x:Key="Ui.Status.HotkeyNeedModifier">Le raccourci doit contenir au moins un modificateur.</sys:String>
    <sys:String x:Key="Ui.Status.HotkeyUpdated">Raccourci mis à jour.</sys:String>
    <sys:String x:Key="Ui.Status.ErrorPrefix">Erreur: {0}</sys:String>

