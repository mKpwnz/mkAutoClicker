    <sys:String x:Key="Ui.Timing.Variation.Description">0 à 95 % de variation sur l'intervalle.</sys:String>
    <sys:String x:Key="Ui.Timing.DutyMin.Label">Duty cycle min (%)</sys:String>
    <sys:String x:Key="Ui.Timing.DutyMin.Description">Temps de maintien minimal par cycle.</sys:String>
    <sys:String x:Key="Ui.Timing.DutyMax.Label">Duty cycle max (%)</sys:String>
    <sys:String x:Key="Ui.Timing.DutyMax.Description">Temps de maintien maximal par cycle.</sys:String>

    <sys:String x:Key="Ui.Limits.ClickLimit.Label">Limite de clics</sys:String>
    <sys:String x:Key="Ui.Limits.ClickLimit.Description">Arrête après N clics.</sys:String>
