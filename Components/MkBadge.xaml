<UserControl x:Class="mkAutoClicker.Components.MkBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             Focusable="False"
             mc:Ignorable="d"
             d:Width="120"
             d:Height="26"
             d:DataContext="{d:DesignInstance Type=UserControl}">
    <Border Padding="8,4"
            CornerRadius="6"
            Background="{StaticResource Brush.AppSurfaceSoft}"
            BorderBrush="{StaticResource Brush.AppBorder}"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AppBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock>
            <Run Text="{Binding Label, ElementName=Root, TargetNullValue=''}"
                 Foreground="{StaticResource Brush.TextSecondary}" />
            <Run Text=" " />
            <Run Text="{Binding Value, ElementName=Root, TargetNullValue=''}"
                 Foreground="{Binding ValueForeground, ElementName=Root}" />
        </TextBlock>
    </Border>
</UserControl>
