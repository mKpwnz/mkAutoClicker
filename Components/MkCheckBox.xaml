<UserControl x:Class="mkAutoClicker.Components.MkCheckBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             Focusable="False"
             mc:Ignorable="d"
             d:Text="Enable"
             d:Width="120"
             d:Height="24">
    <UserControl.Resources>
        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Bullet"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource Brush.AppBorderStrong}"
                                    BorderThickness="1"
                                    Background="{StaticResource Brush.AppSurfaceSoft}">
                                <Path x:Name="CheckMark"
                                      Width="11"
                                      Height="11"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      StrokeThickness="2"
                                      Stroke="{StaticResource Brush.AccentText}"
                                      Data="{StaticResource Icon.Check}"
                                      Stretch="Uniform"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>

                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bullet" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Bullet" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bullet" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bullet" Property="Opacity" Value="0.55" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <CheckBox x:Name="InnerCheckBox"
              Style="{StaticResource CheckStyle}"
              Content="{Binding Text, ElementName=Root, TargetNullValue=Enable, FallbackValue=Enable}"
              d:Content="Enable" />
</UserControl>
