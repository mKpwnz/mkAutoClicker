<Window x:Class="mkAutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:comp="clr-namespace:mkAutoClicker.Components"
        mc:Ignorable="d"
        Title="{DynamicResource Ui.Window.Title}"
        Icon="assets/mkautoclicker.png"
        Width="700"
        SizeToContent="Height"
        MinWidth="600"
        MinHeight="200"
        ResizeMode="CanMinimize"
        Background="{StaticResource Brush.AppBackground}">
    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,6"
                Background="{StaticResource Brush.AppSurface}"
                BorderBrush="{StaticResource Brush.AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Ui.Header.Status.Initial}" />

                <StackPanel Grid.Column="1"
                            Margin="10,0,12,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ClicksTextBlock"
                               Margin="0,0,12,0"
                               Text="{DynamicResource Ui.Header.Clicks.Initial}"
                               Style="{StaticResource BodySecondaryText}" />
                    <TextBlock x:Name="ElapsedTextBlock"
                               Text="{DynamicResource Ui.Header.Elapsed.Initial}"
                               Style="{StaticResource BodySecondaryText}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <comp:MkButton x:Name="StartButton"
                                   Width="32"
                                   Height="28"
                                   Margin="0,0,8,0"
                                   Variant="Primary"
                                   Text=""
                                   IconSize="14"
                                   IconStrokeThickness="1.6"
                                   IconPathData="{StaticResource Icon.Play}" />

                    <comp:MkButton x:Name="StopButton"
                                   Width="32"
                                   Height="28"
                                   Variant="Destructive"
                                   Text=""
                                   IconSize="14"
                                   IconStrokeThickness="1.6"
                                   IconPathData="{StaticResource Icon.Stop}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource Brush.AppBackground}">
            <Grid Margin="12">
                <TabControl x:Name="MainTabControl"
                            Margin="0,0,1,0"
                            SelectionChanged="MainTabControl_SelectionChanged"
                            Style="{StaticResource AppTabControlStyle}">
                    <TabItem Header="{DynamicResource Ui.Tab.Action}"
                             Style="{StaticResource AppTabItemStyle}">
                        <StackPanel>
                            <comp:SettingRow Label="{DynamicResource Ui.Action.InputType.Label}"
                                             Description="{DynamicResource Ui.Action.InputType.Description}">
                                <comp:MkSelectField x:Name="ActionTypeComboBox" MinWidth="220" />
                            </comp:SettingRow>

                            <comp:SettingRow x:Name="KeyboardKeyRow"
                                             Label="{DynamicResource Ui.Action.KeyboardKey.Label}"
                                             Description="{DynamicResource Ui.Action.KeyboardKey.Description}">
                                <comp:MkSelectField x:Name="KeyboardKeyComboBox" MinWidth="220" />
                            </comp:SettingRow>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{DynamicResource Ui.Tab.Timing}"
                             Style="{StaticResource AppTabItemStyle}">
                        <StackPanel>
                            <comp:SettingRow Label="{DynamicResource Ui.Timing.ClicksPerSecond.Label}"
                                             Description="{DynamicResource Ui.Timing.ClicksPerSecond.Description}">
                                <comp:MkTextBox x:Name="ClicksPerSecondTextBox" MinWidth="220" />
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Timing.Interval.Label}"
                                             Description="{DynamicResource Ui.Timing.Interval.Description}">
                                <comp:MkTextBox x:Name="IntervalMsTextBox" MinWidth="220" />
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Timing.Variation.Label}"
                                             Description="{DynamicResource Ui.Timing.Variation.Description}">
                                <comp:MkTextBox x:Name="VariationTextBox" MinWidth="220" />
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Timing.DutyMin.Label}"
                                             Description="{DynamicResource Ui.Timing.DutyMin.Description}">
                                <comp:MkTextBox x:Name="DutyMinTextBox" MinWidth="220" />
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Timing.DutyMax.Label}"
                                             Description="{DynamicResource Ui.Timing.DutyMax.Description}">
                                <comp:MkTextBox x:Name="DutyMaxTextBox" MinWidth="220" />
                            </comp:SettingRow>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{DynamicResource Ui.Tab.Limits}"
                             Style="{StaticResource AppTabItemStyle}">
                        <StackPanel>
                            <comp:SettingRow Label="{DynamicResource Ui.Limits.ClickLimit.Label}"
                                             Description="{DynamicResource Ui.Limits.ClickLimit.Description}">
                                <Grid MinWidth="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <comp:MkCheckBox x:Name="EnableClickLimitCheckBox"
                                                     Grid.Column="0"
                                                     Text="{DynamicResource Ui.Common.Enable}" />
                                    <comp:MkTextBox x:Name="ClickLimitTextBox"
                                                    Grid.Column="2" />
                                </Grid>
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Limits.TimeLimit.Label}"
                                             Description="{DynamicResource Ui.Limits.TimeLimit.Description}">
                                <Grid MinWidth="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <comp:MkCheckBox x:Name="EnableTimeLimitCheckBox"
                                                     Grid.Column="0"
                                                     Text="{DynamicResource Ui.Common.Enable}" />
                                    <comp:MkTextBox x:Name="TimeLimitSecondsTextBox"
                                                    Grid.Column="2" />
                                </Grid>
                            </comp:SettingRow>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{DynamicResource Ui.Tab.Hotkey}"
                             Style="{StaticResource AppTabItemStyle}">
                        <StackPanel>
                            <comp:SettingRow Label="{DynamicResource Ui.Hotkey.Configured.Label}"
                                             Description="{DynamicResource Ui.Hotkey.Configured.Description}">
                                <comp:MkBadge x:Name="HotkeyDisplayBadge"
                                              MinWidth="220"
                                              Label=""
                                              ValueForeground="{StaticResource Brush.TextPrimary}" />
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Hotkey.Mode.Label}"
                                             Description="{DynamicResource Ui.Hotkey.Mode.Description}">
                                <comp:MkSelectField x:Name="HotkeyModeComboBox" MinWidth="220" />
                            </comp:SettingRow>

                            <comp:SettingRow Label="{DynamicResource Ui.Hotkey.Record.Label}"
                                             Description="{DynamicResource Ui.Hotkey.Record.Description}">
                                <comp:MkButton x:Name="RecordHotkeyButton"
                                               MinWidth="220"
                                               Variant="Outline"
                                               Text="{DynamicResource Ui.Hotkey.Record.Button}" />
                            </comp:SettingRow>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
